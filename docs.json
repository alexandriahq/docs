{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Ambient",
  "description": "Documentation for Ambient, the local context layer that helps agents continue your work.",
  "theme": "maple",
  "colors": {
    "primary": "#277487",
    "light": "#83C1C1",
    "dark": "#4F8F98"
  },
  "appearance": {
    "default": "dark"
  },
  "fonts": {
    "family": "Geist",
    "heading": {
      "family": "Geist",
      "weight": 550
    },
    "body": {
      "family": "Geist",
      "weight": 400
    }
  },
  "icons": {
    "library": "lucide"
  },
  "favicon": "/logo/ambient-mark.png",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "icon": "book-open",
        "groups": [
          {
            "group": "Get Started",
            "icon": "rocket",
            "pages": [
              "index",
              "quickstart",
              "introduction"
            ]
          },
          {
            "group": "Guides",
            "icon": "waypoints",
            "pages": [
              "guides/memory",
              "guides/integrations",
              "guides/handoffs"
            ]
          }
        ]
      }
    ]
  }
}
